#!/bin/sh
# Frena cualquier commit que lleve secretos o datos trazables (SECURITY.md, regla 1): claves, tokens, IPs reales,
# MACs, ficheros de datos y lo que haya en la lista privada de cada persona.
#
#   git config core.hooksPath .githooks     activarlo (una vez por clon)
#   .githooks/pre-commit --todo             revisar el repo entero, no solo lo que vas a commitear
#
# IPs permitidas en el repo (todo lo demás se bloquea):
#   - rangos de documentación: 192.0.2.x, 198.51.100.x, 203.0.113.x y 2001:db8::/32
#   - redes privadas de ejemplo: 192.168.99.x, 10.99.x.x, 172.16.99.x y 100.100.100.x
#   - direcciones de red (acabadas en .0), máscaras y especiales: 127.x, 0.0.0.0, 169.254.x, 239.255.255.250
#   - límites de rango que usan los tests: 172.32.0.1 y 100.128.0.1
#
# Los datos privados de cada persona (nombres de sitios, nombre del equipo, MACs…) NO van aquí, porque este fichero
# es público: van en .git/info/datos-privados, uno por línea, que Git nunca sube.
set -u
fail=0

if [ "${1:-}" = "--todo" ]; then
  files=$(git ls-files)
  added=$(git ls-files -z | xargs -0 grep -IHn "" -- 2>/dev/null | grep -v '^internal/server/web/vendor/' || true)
else
  files=$(git diff --cached --name-only --diff-filter=ACMR)
  added=$(git diff --cached -U0 --no-color --diff-filter=ACMR | grep '^+' | grep -v '^+++' || true)
fi

# 1. Secretos con forma conocida.
if printf '%s\n' "$added" | grep -nE 'BEGIN [A-Z ]*PRIVATE KEY|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|sk-[A-Za-z0-9_-]{32,}|AIza[0-9A-Za-z_-]{35}'; then
  echo "✗ Esto parece una clave o un token." >&2; fail=1
fi

# 2. Ficheros que nunca van al repo.
bad=$(printf '%s\n' "$files" | grep -iE '(^|/)(\.env(\..+)?|state\.json|secret\.key|setup-code\.txt|[^/]*\.(pem|key|p12|pfx|log|sqlite3?|db|pcap))$' | grep -v '\.env\.example$' || true)
if [ -n "$bad" ]; then
  echo "✗ Ficheros que no pueden subirse:" >&2; printf '  %s\n' $bad >&2; fail=1
fi

# 3. IPv4 que no son de ejemplo. (Se ignoran las versiones con ceros a la izquierda, tipo 9.0.05.33.)
ips=$(printf '%s\n' "$added" | grep -oE '(^|[^0-9.])([0-9]{1,3}\.){3}[0-9]{1,3}([^0-9.]|$)' \
  | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | grep -vE '(^|\.)0[0-9]' | sort -u \
  | grep -vE '^(192\.0\.2\.|198\.51\.100\.|203\.0\.113\.|192\.168\.99\.|10\.99\.|172\.16\.99\.|100\.100\.100\.|127\.|169\.254\.|255\.)' \
  | grep -vE '\.0$|^0\.0\.0\.0$|^239\.255\.255\.250$|^172\.32\.0\.1$|^100\.128\.0\.1$' || true)
if [ -n "$ips" ]; then
  echo "✗ IPs que no son de ejemplo (usa 192.0.2.x o 192.168.99.x):" >&2; printf '  %s\n' $ips >&2; fail=1
fi

# 4. IPv6 globales que no son de documentación.
ip6=$(printf '%s\n' "$added" | grep -oiE '(^|[^0-9a-z:])[23][0-9a-f]{3}:[0-9a-f]{0,4}:[0-9a-f:]*' | grep -oiE '[23][0-9a-f]{3}:[0-9a-f:]+' | grep -viE '^2001:0?db8:' | sort -u || true)
if [ -n "$ip6" ]; then
  echo "✗ IPv6 reales (usa 2001:db8::):" >&2; printf '  %s\n' $ip6 >&2; fail=1
fi

# 5. MACs (salvo la de ceros y el rango de documentación 00:00:5e:00:53:xx).
macs=$(printf '%s\n' "$added" | grep -oiE '(^|[^0-9a-f:-])([0-9a-f]{2}[:-]){5}[0-9a-f]{2}([^0-9a-f:-]|$)' | grep -oiE '([0-9a-f]{2}[:-]){5}[0-9a-f]{2}' \
  | grep -viE '^00[:-]00[:-]00[:-]00[:-]00[:-]00$|^00[:-]00[:-]5e[:-]00[:-]53[:-]' | sort -u || true)
if [ -n "$macs" ]; then
  echo "✗ Direcciones MAC:" >&2; printf '  %s\n' $macs >&2; fail=1
fi

# 6. Datos privados de esta persona (lista local, nunca versionada; sin distinguir mayúsculas).
priv="$(git rev-parse --git-dir)/info/datos-privados"
if [ -f "$priv" ]; then
  pats=$(mktemp)
  # Todo a minúsculas en vez de grep -i: el grep 3.0 de Git para Windows se cae con -i -F -f.
  grep -vE '^[[:space:]]*(#|$)' "$priv" | tr -d '\r' | tr 'A-Z' 'a-z' > "$pats" || true
  if [ -s "$pats" ]; then
    printf '%s\n' "$added" | tr 'A-Z' 'a-z' | grep -nF -f "$pats"
    rc=$?
    # 0 = hay coincidencias, 1 = limpio, otro = grep ha fallado: también se bloquea, nunca se da por bueno.
    if [ "$rc" -eq 0 ]; then
      echo "✗ Contiene datos de .git/info/datos-privados." >&2; fail=1
    elif [ "$rc" -ne 1 ]; then
      echo "✗ No he podido revisar la lista privada (grep ha fallado)." >&2; fail=1
    fi
  fi
  rm -f "$pats"
fi

# 7. gitleaks, si está instalado.
if command -v gitleaks >/dev/null 2>&1 && [ "${1:-}" != "--todo" ]; then
  gitleaks protect --staged --no-banner --redact || fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "Bloqueado. Quita el dato (y si era un secreto real, cámbialo: ya no es secreto)." >&2
  exit 1
fi
[ "${1:-}" = "--todo" ] && echo "✓ Repo limpio: sin secretos, IPs reales, MACs ni datos privados."
exit 0
